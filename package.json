{
  "name": "coyv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c gray,magenta,cyan \"npm:dev:db\" \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
