# Local development env for the API. Copy to server/.env and adjust.
#
#   cp server/.env.example server/.env
#
# `npm run dev` (from the repo root) starts MongoDB, this API, and Vite.

# Points at the throwaway Mongo that `npm run dev` starts on 27017.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=coyv

# The Vite dev server. Used for CORS and Stripe return URLs.
PUBLIC_SITE_URL=http://localhost:5173
PORT=4000

# Any string of 32+ characters is fine locally: openssl rand -base64 48
JWT_SECRET=local-development-only-secret-not-for-production-use
SESSION_TTL_HOURS=12

# Placeholders so the server boots. Payments stay disabled until these are
# real test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
CURRENCY=usd

# Image uploads need real AWS credentials; browsing the catalogue does not.
AWS_REGION=us-east-1
S3_BUCKET=coyv-assets-162956754427
S3_SIGNED_URL_TTL_SECONDS=3600
# Local dev shares the real assets bucket, so it has to sign with the coyv
# account. Without these the SDK falls back to whatever ambient AWS profile the
# machine happens to have — if that is a different account every image 403s
# with an s3:ListBucket AccessDenied, which looks like a missing file.
# AWS_PROFILE=coyv-cli
# AWS_SHARED_CREDENTIALS_FILE=/absolute/path/to/repo/.aws-credentials
# AWS_CONFIG_FILE=/dev/null
MAX_UPLOAD_BYTES=15728640

# Brevo (transactional email). A placeholder key is treated as "not
# configured": the app still boots and every send becomes a logged no-op
# saying what it would have sent, so nothing breaks before the real key
# arrives. Local dev is meant to stay on the placeholder — a real key here
# sends real mail to real customers. Keys: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-REPLACE_ME
# Customer-facing mail (orders, renewals, shipping notices).
BREVO_SENDER_EMAIL=orders@coyvcastle.com
# Automated mail nobody should answer (sign-in links, admin digest).
BREVO_NOREPLY_EMAIL=noreply@coyvcastle.com
BREVO_SENDER_NAME=coyv

# Optional Reply-To on customer mail. coyvcastle.com sends but does not
# receive (no MX record), so without this a customer who hits reply is
# writing to a mailbox that does not exist. Set it to a real inbox.
# SUPPORT_REPLY_TO=

# Who gets the daily "parcels to send" digest. Comma-separated; blank
# disables it entirely. This must be a mailbox that actually receives mail —
# coyvcastle.com has no MX, so an @coyvcastle.com address here will bounce.
ADMIN_NOTIFICATION_EMAILS=

# Must match the frontend's VITE_ADMIN_PATH so digest links land correctly.
ADMIN_PATH=/studio-back-door

# A pending parcel older than this many days is flagged past due.
FULFILLMENT_PAST_DUE_DAYS=3
# Above this many outstanding parcels the digest links instead of listing.
DIGEST_MAX_ITEMS=10

# Shared secret for POST /api/tasks/daily-digest, sent as x-tasks-secret.
# Unset means the endpoint 404s rather than running unauthenticated.
TASKS_SECRET=local-tasks-secret
