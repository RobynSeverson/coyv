# Copy to .env and fill in. Never commit the real file.

# --- database ---------------------------------------------------------
MONGO_ROOT_USERNAME=coyv
MONGO_ROOT_PASSWORD=change-me
MONGODB_DB_NAME=coyv

# Only needed when running the API outside Docker (npm run dev in server/).
# MONGODB_URI=mongodb://localhost:27017

# --- site -------------------------------------------------------------
# Where the browser app is served from. Used for CORS.
PUBLIC_SITE_URL=http://localhost:8080
WEB_PORT=8080

# --- admin session ----------------------------------------------------
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
SESSION_TTL_HOURS=12

# --- stripe -----------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4000/api/stripe/webhook`,
# or from the endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
CURRENCY=usd

# --- s3 ---------------------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=
# Omit both to fall back to the instance/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only for MinIO / LocalStack.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=15728640

# --- admin panel ------------------------------------------------------
# The unlinked route the admin UI is mounted at. Baked in at build time.
VITE_ADMIN_PATH=/studio-back-door
